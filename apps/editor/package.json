{
  "name": "@ee/editor",
  "version": "0.0.1",
  "private": true,
  "description": "early earle Wesen-Editor: Shape-/3D-Editor als Desktop-App (Electron), Renderer läuft auch im Browser",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "EDITOR_WEB=1 vite --port 5180 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "package": "pnpm build && electron-builder --mac --dir",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@ee/shape": "workspace:*",
    "@fontsource/irish-grover": "5.2.7",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.16.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.186.1",
    "typescript": "~5.9.0",
    "vite": "^8.3.1",
    "vite-plugin-electron": "1.1.2",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "de.illudiy.earle.editor",
    "productName": "early earle Editor",
    "directories": { "output": "release" },
    "files": ["dist/**", "dist-electron/**", "package.json"],
    "npmRebuild": false,
    "mac": { "target": "dir", "category": "public.app-category.graphics-design", "identity": "-" }
  }
}
