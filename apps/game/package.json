    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "e2e:pw": "playwright test",
    "ios:icons": "bash scripts/ios-icons.sh",
    "ios:sim": "bash scripts/ios-sim.sh",
    "ios:device": "bash scripts/ios-device.sh"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@ee/core": "workspace:*",
    "@ee/genome": "workspace:*",
    "@ee/liquid-glass": "link:./plugins/liquid-glass",
    "@ee/physics": "workspace:*",
    "@ee/render": "workspace:*",
    "@ee/world": "workspace:*",
    "mitt": "^3.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "three": "0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9.0",
