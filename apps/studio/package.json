{
  "name": "@ee/studio",
  "version": "0.0.1",
  "private": true,
  "description": "Studio: Editor, Messseite, Prüfseite, Seite P1 und die Server-Erweiterungen beider Apps",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--import=$PWD/scripts/proben/schutz.mjs vite --port ${STUDIO_PORT:-5263} --strictPort --host",
    "stand:bauen": "vite build",
    "stand:zeigen": "vite preview --port 5217 --strictPort --host",
    "typecheck": "node ../../scripts/studio-typen.mjs",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@ee/studio-ablage": "workspace:*",
    "@ee/studio-autorig": "workspace:*",
    "@ee/studio-bild": "workspace:*",
    "@ee/studio-format": "workspace:*",
    "@ee/studio-laufzeit": "workspace:*",
    "@ee/studio-rechnen": "workspace:*",
    "@ee/studio-store": "workspace:*",
    "@ee/studio-ton": "workspace:*",
    "@ee/studio-welt": "workspace:*",
    "idb": "8.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fast-check": "4.10.2",
    "typescript": "~5.9.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "webdriverio": "10.2.0"
  }
}
