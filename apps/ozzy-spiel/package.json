{
  "name": "@ee/ozzy-spiel",
  "version": "0.0.1",
  "private": true,
  "description": "Gassirunde: die Demo, komplett mit den Mitteln von Studio gebaut",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--import=$PWD/../studio/scripts/proben/schutz.mjs vite --port ${SPIEL_PORT:-5265} --strictPort --host",
    "stand:bauen": "vite build",
    "stand:zeigen": "vite preview --port 5261 --strictPort --host",
    "typecheck": "node ../../scripts/studio-typen.mjs",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@ee/studio-bild": "workspace:*",
    "@ee/studio-format": "workspace:*",
    "@ee/studio-laufzeit": "workspace:*",
    "@ee/studio-ton": "workspace:*",
    "@ee/studio-welt": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
