{
  "name": "early-earle",
  "private": true,
  "version": "0.0.1",
  "description": "early earle — levelbasiertes 2048 im Stil 'Neo-Brutalismus trifft Eyvind Earle' (illudiy)",
  "packageManager": "pnpm@12.6.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "pnpm --filter @ee/game dev",
    "editor": "pnpm --filter @ee/editor dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @ee/game build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @ee/game e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "assets:blender": "node tools/export3d/assets-blender.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
